# SW-7 telemetry bridge as an always-on service on the Raspberry Pi 4.
# Starts at boot, restarts if it stops unexpectedly, and serves
# GET /telemetry on port 8081 for the Pi 5 dashboard: the latest DASH line
# from the ESP32 on USB serial plus the three ToF sensors. See
# DashboardIntegration/TELEMETRY_LINK.md for the JSON.
#
# It keeps running with the ESP32 unplugged or the ToF sensors absent
# (those parts read null) and reopens the serial port when it comes back.
# Telemetry numbers only: no camera frames, nothing written to disk.
#
# The user must be in the dialout group (serial) and the i2c and gpio
# groups (ToF), which is the default for the first Pi OS user.
# Only one program can use the ToF sensors at a time, so stop this
# service before running tof_reader.py by hand.
#
# Install: see CameraDetection/deploy/INSTALL.md

[Unit]
Description=SW-7 telemetry bridge (ESP32 serial and ToF on :8081)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ogeder
WorkingDirectory=/home/ogeder/hazard_detector
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ogeder/hazard_detector/venv/bin/python3 /home/ogeder/hazard_detector/telemetry_bridge.py --serial-port /dev/ttyACM0 --host 0.0.0.0 --port 8081
Restart=on-failure
RestartSec=3
# SIGTERM is handled in the script: the serial port, sensors and HTTP
# server are released cleanly before it exits.
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
