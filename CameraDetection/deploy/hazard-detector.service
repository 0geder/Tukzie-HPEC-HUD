# SW-7 hazard detector as an always-on service on the Raspberry Pi 4.
# Starts at boot, restarts if it stops unexpectedly, and serves the live
# view and GET /alerts on port 8080 for the dashboard.
#
# --preview-host 0.0.0.0 lets the Pi 5 dashboard reach it over the
# network. Agree that with the supervisor before enabling this on a
# shared network (see CameraDetection/README.md). For a Pi-only setup,
# drop "--preview-host 0.0.0.0" from ExecStart.
#
# Install: see CameraDetection/deploy/INSTALL.md

[Unit]
Description=SW-7 camera hazard detector (live view and alerts on :8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ogeder
WorkingDirectory=/home/ogeder/hazard_detector
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ogeder/hazard_detector/venv/bin/python3 /home/ogeder/hazard_detector/hazard_detector.py --tuning ov5647_noir.json --saturation 1.8 --preview --preview-host 0.0.0.0 --log-path /home/ogeder/hazard_detector/alerts.jsonl
Restart=on-failure
RestartSec=3
# SIGTERM is handled in the script: the camera and live view are released
# cleanly before it exits.
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
